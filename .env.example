# ---------- Required (unless you use ./run.sh --dry-run) ----------
STREAM_KEY=your_stream_key_here
# twitch | youtube | facebook | kick | custom
PLATFORM=twitch
# Only needed for kick/custom, or to override the preset ingest URL:
# RTMP_URL=rtmp://live.twitch.tv/app

# ---------- Run length ----------
# Minutes to stream. 0 = until you stop it.
MINUTES=10
# Reconnect automatically (with back-off) if the connection drops.
AUTO_RESTART=1

# ---------- Video / audio quality ----------
RESOLUTION=1280x720
FPS=30
VIDEO_BITRATE=2500k
AUDIO_BITRATE=128k
# ultrafast < superfast < veryfast (default) < faster < fast  (slower = better quality, more CPU)
X264_PRESET=veryfast
# 1 = never touch PulseAudio, stream silence
SILENT_AUDIO=0

# ---------- Web server / control panel ----------
PORT=8080
# Password for the control panel API. REQUIRED if you set BIND=0.0.0.0 (e.g. in Docker).
# ADMIN_TOKEN=choose-a-long-random-string
# BIND=127.0.0.1

# ---------- Content ----------
# Data sources and theme live in config.json (copy config.example.json).
# CONFIG=config.json
# Optional token for the GitHub source (raises API rate limits):
# GITHUB_TOKEN=
# What the stream shows when it STARTS: a YouTube link or any web page instead of the dashboard (keep the quotes).
# Editing this while the stream is running does nothing. To change the video LIVE with no restart, open
# http://127.0.0.1:8080/control.html and use "Video source".
# PAGE_URL='https://www.youtube.com/watch?v=VIDEO_ID'

# ---------- VTuber mode (Python-drawn character with babble voice and subtitles) ----------
# 1 = stream web/vtuber.html instead of the dashboard and run the VTuber director. See README.
VTUBER=0
# 1 = she reacts to the headlines the data agent fetched (needs the sources in config.json)
VTUBER_NEWS=0
# Her name (subtitle tag), voice pitch in Hz, and a custom script file (default: vtuber/lines.txt)
# VTUBER_NAME=Pyon
# VOICE_PITCH=150
# VTUBER_SCRIPT=vtuber/lines.txt
